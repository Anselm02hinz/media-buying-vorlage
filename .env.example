# Zugangsdaten · Budgetrunde (nur die Namen; nie echte Werte in diese Datei)
# Codex: in der Codex-Umgebung unter "Environment variables" eintragen (ANLEITUNG.md, B3), nicht unter
# "HTTP secrets": die Skripte brauchen den Wert selbst. Lokal: als .env kopieren (nicht versioniert) und Werte eintragen.

# Meta Marketing API: System-User-Token mit Zugriff nur auf die Konten in <startup>/startup.json.
# Zunächst nur ads_read.
META_ACCESS_TOKEN=
# Graph-API-Version, leer = v26.0
META_API_VERSION=

# Triple Whale API (Scope: Lesen). Shop-Domain steht in <startup>/startup.json; hier nur bei Bedarf überschreiben.
TRIPLEWHALE_API_KEY=
TRIPLEWHALE_SHOP_DOMAIN=

# test = Testlauf mit erfundenen Daten aus <startup>/testdaten (keine Keys nötig, nichts wird ausgeführt). Leer = echter Lauf.
MEDIA_BUYING_MODUS=

# Schreibzugriff auf Meta (plan.py ausfuehren). Nur der Systemverantwortliche oder der Entscheider
# (<startup>/startup.json) setzen ihn auf 1, zusammen mit einem Token mit ads_management. Standard: gesperrt.
META_WRITE_ENABLED=0
